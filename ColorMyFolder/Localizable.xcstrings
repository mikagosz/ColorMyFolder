{
  "sourceLanguage": "en",
  "strings": {
    "%lld colors, %lld colored folders": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolory: %1$lld, pokolorowane foldery: %2$lld"
          }
        }
      }
    },
    "A new list sets the old one aside in the same folder. Another Mac using this place will switch to the new list too.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowa lista odłoży starą obok, w tym samym folderze. Drugi Mac korzystający z tego miejsca też przejdzie na nową listę."
          }
        }
      }
    },
    "Change…": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmień…"
          }
        }
      }
    },
    "Choose": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz"
          }
        }
      }
    },
    "Choose Another Place…": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz inne miejsce…"
          }
        }
      }
    },
    "Choose Folders…": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz foldery…"
          }
        }
      }
    },
    "Choose Other Folders…": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz inne foldery…"
          }
        }
      }
    },
    "Choose the folders to color.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz foldery do pokolorowania."
          }
        }
      }
    },
    "Color Folder": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokoloruj"
          }
        }
      }
    },
    "ColorMyFolder found an existing list": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ColorMyFolder znalazł istniejącą listę"
          }
        }
      }
    },
    "Delete Color": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń kolor"
          }
        }
      }
    },
    "Folders: %lld": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foldery: %lld"
          }
        }
      }
    },
    "List location": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miejsce listy"
          }
        }
      }
    },
    "No folder chosen": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wybrano folderu"
          }
        }
      }
    },
    "No saved colors yet — pick a color below and click “Save Color”.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zapisanych kolorów — wybierz kolor niżej i kliknij „Zapisz kolor”."
          }
        }
      }
    },
    "Not set": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ustawiono"
          }
        }
      }
    },
    "Other Color": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inny kolor"
          }
        }
      }
    },
    "Restore System Look": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywróć systemowy"
          }
        }
      }
    },
    "Save Color": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz kolor"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia"
          }
        }
      }
    },
    "Start a New List": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij nową listę"
          }
        }
      }
    },
    "This place already has a ColorMyFolder list": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym miejscu jest już lista ColorMyFolder"
          }
        }
      }
    },
    "Use It": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj jej"
          }
        }
      }
    },
    "Use This List": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj tej listy"
          }
        }
      }
    },
    "Use it to share colors with your other Mac, or choose another place.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj jej, żeby mieć te same kolory co na drugim Macu, albo wybierz inne miejsce."
          }
        }
      }
    },
    "Where should ColorMyFolder keep its list of colors and colored folders? It creates a hidden .ColorMyFolder folder in the place you choose. Choose a folder you sync between your Macs, and both will have the same colors.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdzie trzymać listę kolorów i pokolorowanych folderów? ColorMyFolder utworzy w wybranym miejscu ukryty folder .ColorMyFolder. Wybierz folder synchronizowany między Makami, a oba będą miały te same kolory."
          }
        }
      }
    }
  },
  "version": "1.0"
}
