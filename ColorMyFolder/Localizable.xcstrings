      }
    },
    "Save Color adds the current color to your saved colors.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Color adds the current color to your saved colors."
          }
        },
