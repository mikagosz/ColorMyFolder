          "stringUnit": {
            "state": "translated",
            "value": "Przywróć systemowy — obok Wybierz inne foldery…."
          }
        }
      }
    },
    "If a folder has a custom icon ColorMyFolder did not set, the app asks before removing it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a folder has a custom icon ColorMyFolder did not set, the app asks before removing it."
