    "Restore System Look gives the folder its normal icon back.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore System Look gives the folder its normal icon back."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywróć systemowy oddaje folderowi zwykłą ikonę."
          }
        }
