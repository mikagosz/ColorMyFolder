          }
        }
      }
    },
    "The list lives in a hidden .ColorMyFolder folder inside the place you choose. Choose a folder you sync between your Macs, and both will have the same colors.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list lives in a hidden .ColorMyFolder folder inside the place you choose. Choose a folder you sync between your Macs, and both will have the same colors."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista leży w ukrytym folderze .ColorMyFolder w wybranym miejscu. Wybierz folder synchronizowany między Twoimi Macami, a oba będą miały te same kolory."
          }
        }
      }
    },
    "Good to know": {
      "extractionState": "manual",
