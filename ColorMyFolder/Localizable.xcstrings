{
  "sourceLanguage": "en",
  "strings": {
    "%lld colors, %lld colored folders": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolory: %1$lld, pokolorowane foldery: %2$lld"
          }
        }
      }
    },
    "A new list sets the old one aside in the same folder. Another Mac using this place will switch to the new list too.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowa lista odłoży starą obok, w tym samym folderze. Drugi Mac korzystający z tego miejsca też przejdzie na nową listę."
          }
        }
      }
    },
    "A newer version is available": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jest nowsza wersja"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuluj"
          }
        }
      }
    },
    "Change…": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmień…"
          }
        }
      }
    },
    "Check Now": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź teraz"
          }
        }
      }
    },
    "Check for updates once a month": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzaj aktualizacje raz w miesiącu"
          }
        }
      }
    },
    "Choose": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz"
          }
        }
      }
    },
    "Choose Another Place…": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz inne miejsce…"
          }
        }
      }
    },
    "Choose Folders…": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz foldery…"
          }
        }
      }
    },
    "Choose Other Folders…": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz inne foldery…"
          }
        }
      }
    },
    "Choose the folders to color.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz foldery do pokolorowania."
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij"
          }
        }
      }
    },
    "Color Folder": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokoloruj"
          }
        }
      }
    },
    "ColorMyFolder found an existing list": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ColorMyFolder znalazł istniejącą listę"
          }
        }
      }
    },
    "ColorMyFolder is still drawing folder icons — the update would cut that off. Click again when it finishes.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ColorMyFolder jeszcze rysuje ikony folderów — aktualizacja by to przerwała. Kliknij ponownie, gdy skończy."
          }
        }
      }
    },
    "ColorMyFolder — Update": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ColorMyFolder — Aktualizacja"
          }
        }
      }
    },
    "Colors and folders are not saved until you choose where to keep the list — use the gear.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolory i foldery nie są zapisywane, dopóki nie wybierzesz miejsca na listę — użyj zębatki."
          }
        }
      }
    },
    "Could not check for updates": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się sprawdzić aktualizacji"
          }
        }
      }
    },
    "Could not download the new version.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się pobrać nowej wersji."
          }
        }
      }
    },
    "Could not install the new version. The app keeps running the current one.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zainstalować nowej wersji. Program działa dalej w obecnej."
          }
        }
      }
    },
    "Delete Color": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń kolor"
          }
        }
      }
    },
    "Download manually and replace it yourself": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobierz ręcznie i podmień sam"
          }
        }
      }
    },
    "Downloading and verifying the package…": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobieram i sprawdzam paczkę…"
          }
        }
      }
    },
    "Folders: %lld": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foldery: %lld"
          }
        }
      }
    },
    "Install and Restart": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstaluj i uruchom ponownie"
          }
        }
      }
    },
    "Installing — the app will restart in a moment…": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaluję — za chwilę program uruchomi się ponownie…"
          }
        }
      }
    },
    "Last: %@": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnio: %@"
          }
        }
      }
    },
    "List location": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miejsce listy"
          }
        }
      }
    },
    "No folder chosen": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wybrano folderu"
          }
        }
      }
    },
    "No saved colors yet — pick a color below and click “Save Color”.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zapisanych kolorów — wybierz kolor niżej i kliknij „Zapisz kolor”."
          }
        }
      }
    },
    "Not checked yet": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nie sprawdzano"
          }
        }
      }
    },
    "Not set": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ustawiono"
          }
        }
      }
    },
    "Other Color": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inny kolor"
          }
        }
      }
    },
    "Remove Icon": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń ikonę"
          }
        }
      }
    },
    "Remove a custom icon ColorMyFolder did not set?": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć własną ikonę, której nie nadał ColorMyFolder?"
          }
        }
      }
    },
    "Replace Icon": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastąp ikonę"
          }
        }
      }
    },
    "Replace a custom icon ColorMyFolder did not set?": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastąpić własną ikonę, której nie nadał ColorMyFolder?"
          }
        }
      }
    },
    "Restore System Look": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywróć systemowy"
          }
        }
      }
    },
    "Save Color": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz kolor"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia"
          }
        }
      }
    },
    "Skip This Version": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomiń tę wersję"
          }
        }
      }
    },
    "Start a New List": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij nową listę"
          }
        }
      }
    },
    "The app asks fractal8.eu for the number of the newest version — it sends nothing else. A new version installs only when you click “Install”.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Program pyta stronę fractal8.eu o numer najnowszej wersji — nic więcej nie wysyła. Nowa wersja instaluje się dopiero, gdy klikniesz „Zainstaluj”."
          }
        }
      }
    },
    "The app downloads the new version, checks it, replaces itself and restarts. Your colors, colored folders and settings stay.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Program pobierze nową wersję, sprawdzi ją, podmieni się i uruchomi ponownie. Kolory, pokolorowane foldery i ustawienia zostają."
          }
        }
      }
    },
    "The app sits where it cannot be overwritten (e.g. opened straight from Downloads). Move it to the Applications folder or download the new version manually.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Program stoi w miejscu, którego nie da się nadpisać (np. otwarty prosto z Pobranych). Przenieś go do katalogu Aplikacje albo pobierz nową wersję ręcznie."
          }
        }
      }
    },
    "The list cannot be read right now, so changes are not saved. If it is in iCloud Drive, wait until it downloads.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Listy nie da się teraz odczytać, więc zmiany nie są zapisywane. Jeśli leży w iCloud Drive, poczekaj, aż się pobierze."
          }
        }
      }
    },
    "The new version is installed, but the restart failed. Quit and reopen the app manually.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowa wersja jest zainstalowana, ale restart się nie udał. Zamknij i otwórz program ręcznie."
          }
        }
      }
    },
    "The package address leads outside fractal8.eu — the app will not download it.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres paczki prowadzi poza serwer fractal8.eu — program jej nie pobierze."
          }
        }
      }
    },
    "This folder already has its own icon. ColorMyFolder cannot bring it back afterwards.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten folder ma już własną ikonę. ColorMyFolder nie umie jej potem przywrócić."
          }
        }
      }
    },
    "This place already has a ColorMyFolder list": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym miejscu jest już lista ColorMyFolder"
          }
        }
      }
    },
    "Updates": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizacje"
          }
        }
      }
    },
    "Use It": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj jej"
          }
        }
      }
    },
    "Use This List": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj tej listy"
          }
        }
      }
    },
    "Use it to share colors with your other Mac, or choose another place.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj jej, żeby mieć te same kolory co na drugim Macu, albo wybierz inne miejsce."
          }
        }
      }
    },
    "Version %@": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja %@"
          }
        }
      }
    },
    "Version %@.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja %@."
          }
        }
      }
    },
    "Where should ColorMyFolder keep its list of colors and colored folders? It creates a hidden .ColorMyFolder folder in the place you choose. Choose a folder you sync between your Macs, and both will have the same colors.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdzie trzymać listę kolorów i pokolorowanych folderów? ColorMyFolder utworzy w wybranym miejscu ukryty folder .ColorMyFolder. Wybierz folder synchronizowany między Makami, a oba będą miały te same kolory."
          }
        }
      }
    },
    "You are up to date": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz najnowszą wersję"
          }
        }
      }
    },
    "You have %@, version %@ is available.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz %@, dostępna jest %@."
          }
        }
      }
    },
    "ColorMyFolder Help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ColorMyFolder Help"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomoc ColorMyFolder"
          }
        }
      }
    },
    "Help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomoc"
          }
        }
      }
    },
    "Getting started with ColorMyFolder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting started with ColorMyFolder"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwsze kroki z ColorMyFolder"
          }
        }
      }
    },
    "Any color for any folder, in the look of a real macOS folder — not just the seven tag colors.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any color for any folder, in the look of a real macOS folder — not just the seven tag colors."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dowolny kolor dla dowolnego folderu, w wyglądzie prawdziwego folderu macOS — nie tylko siedem kolorów tagów."
          }
        }
      }
    },
    "Straight from Finder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight from Finder"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosto z Findera"
          }
        }
      }
    },
    "ColorMyFolder waits in Finder's menu. Pick the folders there, and the window opens with them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ColorMyFolder waits in Finder's menu. Pick the folders there, and the window opens with them."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ColorMyFolder czeka w menu Findera. Wybierz tam foldery, a okno otworzy się już z nimi."
          }
        }
      }
    },
    "Right-click a folder, or several.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click a folder, or several."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij prawym przyciskiem folder albo kilka folderów."
          }
        }
      }
    },
    "Quick Actions → ColorMyFolder. The same item is also under Services.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Actions → ColorMyFolder. The same item is also under Services."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybkie czynności → ColorMyFolder. Ta sama pozycja jest też w Usługach."
          }
        }
      }
    },
    "The window opens with the folders you picked.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The window opens with the folders you picked."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okno otwiera się z wybranymi folderami."
          }
        }
      }
    },
    "The app runs quietly in the background and starts at login, so the paper sheet in a colored folder appears as soon as you put something in it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app runs quietly in the background and starts at login, so the paper sheet in a colored folder appears as soon as you put something in it."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Program działa po cichu w tle i startuje przy logowaniu, więc kartka w pokolorowanym folderze pojawia się, gdy tylko coś do niego włożysz."
          }
        }
      }
    },
    "Pick a color": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a color"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz kolor"
          }
        }
      }
    },
    "Click one of your saved colors, or pick any color you like.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click one of your saved colors, or pick any color you like."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij jeden z zapisanych kolorów albo wybierz dowolny inny."
          }
        }
      }
    },
    "The folder that gets the color — or how many, when you picked several.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder that gets the color — or how many, when you picked several."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder, który dostanie kolor — albo ile ich jest, gdy wybrałeś kilka."
          }
        }
      }
    },
    "Your saved colors. One click colors the folder and closes the window.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved colors. One click colors the folder and closes the window."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje zapisane kolory. Jedno kliknięcie koloruje folder i zamyka okno."
          }
        }
      }
    },
    "Other Color opens the system color picker; Color Folder applies it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other Color opens the system color picker; Color Folder applies it."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inny kolor otwiera systemowy wybór koloru; Pokoloruj go nakłada."
          }
        }
      }
    },
    "Besides plain colors there are black, white and a metallic chrome. The icon keeps the macOS folder look: the same gradient and shading as Finder's own folders.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Besides plain colors there are black, white and a metallic chrome. The icon keeps the macOS folder look: the same gradient and shading as Finder's own folders."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprócz zwykłych kolorów są czarny, biały i metaliczny chrom. Ikona zachowuje wygląd folderu macOS: ten sam gradient i cieniowanie co foldery Findera."
          }
        }
      }
    },
    "Save your colors": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your colors"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz swoje kolory"
          }
        }
      }
    },
    "Keep the colors you use often, so they are one click away next time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the colors you use often, so they are one click away next time."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj kolory, których używasz często — następnym razem są o jedno kliknięcie."
