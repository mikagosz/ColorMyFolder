        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli folder ma własną ikonę, której nie ustawił ColorMyFolder, program zapyta przed jej usunięciem."
          }
        }
      }
    },
    "A custom icon you pasted yourself in Get Info cannot be brought back once it is replaced, so ColorMyFolder always asks first — when coloring, too.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A custom icon you pasted yourself in Get Info cannot be brought back once it is replaced, so ColorMyFolder always asks first — when coloring, too."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Własnej ikony wklejonej w oknie Pokaż info nie da się przywrócić po zastąpieniu, dlatego ColorMyFolder zawsze najpierw pyta — także przy kolorowaniu."
          }
        }
      }
    },
