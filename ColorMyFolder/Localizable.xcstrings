            "state": "translated",
            "value": "Prawy klik na zapisanym kolorze → Usuń kolor usuwa go."
          }
        }
      }
    },
    "The window can be resized; it remembers its size and place, and when you have many saved colors, they scroll.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The window can be resized; it remembers its size and place, and when you have many saved colors, they scroll."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okno można powiększać; pamięta swój rozmiar i miejsce, a gdy zapisanych kolorów jest dużo, przewijają się."
          }
        }
      }
    },
    "Back to the macOS look": {
      "extractionState": "manual",
